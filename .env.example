# =========================================
# Investly Platform - Environment Variables
# =========================================

# Server Port (Default: 5000)
PORT=5000

# Environment Mode (development / production)
NODE_ENV=development

# MongoDB URI (Defaults to local/in-memory MongoDB if unconfigured)
MONGO_URI=mongodb://127.0.0.1:27017/startup_intelligence

# Optional: Google Gemini API Key for Copilot generative enhancement
# (Note: Built-in in-app intelligence engine works 100% out-of-the-box without this)
GEMINI_API_KEY=
